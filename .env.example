# Salin file ini menjadi .env.local (untuk laptop) — di Vercel, isi lewat
# Project → Settings → Environment Variables.

# ── Supabase (wajib di produksi) ─────────────────────────────────────────
# Supabase → Project Settings → API Keys
#   URL  : Project URL, mis. https://abcdefghijklmnop.supabase.co
#   KEY  : "Publishable key" (sb_publishable_…) atau "anon public" key (eyJ…)
# JANGAN pernah mengisi "secret" / "service_role" key di mana pun.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Alamat situs (untuk SEO, sitemap, gambar kartu link) ────────────────
# Boleh dikosongkan di Vercel (memakai domain produksi otomatis).
NEXT_PUBLIC_SITE_URL=

# ── Mode lokal (mencoba di laptop tanpa Supabase) ───────────────────────
# Biarkan dua variabel Supabase kosong, lalu `npm run dev`.
# Isi disimpan di .data/content.json. Admin masuk dengan kata sandi ini.
ADMIN_LOCAL_PASSWORD=portofolio-lokal
